# Music API Configuration (YouTube Music via ytmusicapi)
# Cache TTL for home sections (1 day = 86400 seconds)
HOME_CACHE_TTL_SECONDS=86400

# Firebase Service Account Credentials Path (File path)
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json

# Alternatively, pass Firebase credentials as a raw JSON string (ideal for CI/Docker/Cloud)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Recommended on Linux to prevent gRPC DNS stalls
GRPC_DNS_RESOLVER=native

# Server Port & Cloud Platform Configuration
# Render automatically injects PORT=10000 and RENDER=true. Defaults to port 8000 on localhost.
PORT=8000
# RENDER=true

# yt-dlp Execution Control:
# - On localhost (local machine port): yt-dlp runs natively as residential IPs are not blocked by YouTube.
# - On Render server (datacenter port/IP): yt-dlp is skipped by default to avoid YouTube bot checks/IP bans,
#   and immediately uses fast decentralized fallbacks (Piped & Invidious).
# - Set ENABLE_SERVER_YTDLP=true only if you have a residential proxy configured below.
ENABLE_SERVER_YTDLP=false

# Optional: YouTube Datacenter Bypass on Cloud Hosting (e.g., Render, AWS, GCP)
# Render Secret File or path to exported cookies.txt
# YOUTUBE_COOKIES_PATH=/etc/secrets/cookies.txt
# Alternatively, pass cookies file content as an environment variable string
# YOUTUBE_COOKIES="# Netscape HTTP Cookie File\n..."
# Optional: Proxy URL for YouTube requests (HTTP/HTTPS/SOCKS5)
# PROXY_URL=http://user:pass@proxy.example.com:8080

